# Token Discord Bot
DISCORD_TOKEN=
# Client ID Discord Bot
CLIENT_ID=
# Required: ID of the Discord server the bot serves (commands and admin actions only work there)
GUILD_ID=
# Default timezone for reminder windows
DEFAULT_TZ=Europe/Paris
# Public URL where the bot can redirect players (required for 1-click voting)
# Example: https://vote-bot.example.com
PUBLIC_BASE_URL=
# Required with PUBLIC_BASE_URL: secret used to sign vote links, 32+ characters (openssl rand -hex 32)
MARK_SECRET=
# HTTP server port for the /v redirect endpoint
PORT=3000
# Language of the bot responses: fr or en
BOT_LANG=fr
